{
  "name": "md-chunkit",
  "version": "0.1.0",
  "description": "Adaptive structural-semantic Markdown chunker for RAG: heading breadcrumbs, atomic lists, table row groups, digit-density budgets and optional embedding-based semantic cuts.",
  "keywords": [
    "rag",
    "chunking",
    "chunker",
    "markdown",
    "retrieval",
    "embeddings",
    "llm",
    "text-splitter",
    "semantic-chunking"
  ],
  "author": "Oleh Lozovyi",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "parity": "npm run build && node scripts/parity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
